generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// PharmaOpsFlow - Core Models
// ============================================

// System-level roles (assigned to User)
enum Role {
  ADMIN           // Super admin - full system access
  COMPANY_MANAGER // Can access all pharmacies in their org
  PHARMACY_ADMIN  // Admin of specific pharmacies (via PharmacyMember)
  PHARMACY_USER   // User of specific pharmacies (via PharmacyMember)
  READ_ONLY       // Read-only access
}

// Pharmacy-level roles (assigned via PharmacyMember)
enum MemberRole {
  PHARMACY_ADMIN
  PHARMACY_USER
  READ_ONLY
}

// ============================================
// Invoice Enums
// ============================================

enum InvoiceStatus {
  DRAFT      // Created but not submitted
  SUBMITTED  // Submitted for approval
  NEEDS_INFO // Returned for more information
  APPROVED   // Approved, pending payment scheduling
  SCHEDULED  // Payment scheduled
  PAID       // Payment completed
  REJECTED   // Rejected
}

enum InvoiceEventType {
  CREATED
  SUBMITTED
  NEEDS_INFO
  APPROVED
  SCHEDULED
  PAID
  REJECTED
  UPDATED
  EXTRACTION_STARTED
  EXTRACTION_COMPLETED
  EXTRACTION_FAILED
  EXTRACTION_APPLIED
}

enum ExtractionStatus {
  NONE      // No extraction attempted
  PENDING   // Extraction in progress
  SUCCESS   // Extraction completed successfully
  FAILED    // Extraction failed
}

enum EntryMethod {
  MANUAL         // Manually entered by user
  AI_EXTRACTION  // Created via AI document extraction
}

enum DocumentType {
  INVOICE
  STATEMENT
  CREDIT_MEMO
  OTHER
}

enum AIProvider {
  GEMINI
  OPENAI
  ANTHROPIC
  OTHER
}

// ============================================
// Organization & Pharmacy Models
// ============================================

model Org {
  id                 String     @id @default(uuid())
  name               String
  phone              String?
  email              String?
  website            String?
  street             String?
  city               String?
  state              String?
  zip                String?
  timezone           String     @default("America/Chicago")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  pharmacies           Pharmacy[]
  users                User[]
  invoiceTypes         InvoiceType[]
  vendors              Vendor[]
  requiredInvoiceTypes      RequiredInvoiceType[]
  frequencies               Frequency[]
  invoiceCategories         InvoiceCategory[]
  notificationPreferences   NotificationPreference[]
}

model Pharmacy {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  code      String   @unique // e.g., "PHM001"
  street    String?
  city      String?
  state     String?  // 2-letter US state code
  zip       String?  // US zip code
  phone     String?
  website   String?
  timezone          String?  @default("America/New_York")
  submissionDueDay  Int?     // Pharmacy-level override (null = use org default)
  processingDueDay  Int?     // Pharmacy-level override (null = use org default)
  isActive          Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members          PharmacyMember[]
  managerAssignments ManagerPharmacy[]
  invoices         Invoice[]
  vendors              Vendor[]
  requiredInvoiceTypes RequiredInvoiceType[]
  monthlyRequirements MonthlyInvoiceRequirement[]
  slaEvents           SlaEvent[]
  notificationLogs    NotificationLog[]
  invoiceRequirements InvoiceRequirement[]

  @@index([orgId])
}

model PharmacyMember {
  id         String     @id @default(uuid())
  userId     String
  pharmacyId String
  memberRole MemberRole @default(PHARMACY_USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@index([userId])
  @@index([pharmacyId])
}

// Manager-to-Pharmacy assignment (COMPANY_MANAGER can only manage assigned pharmacies)
model ManagerPharmacy {
  id         String   @id @default(uuid())
  userId     String
  pharmacyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@index([userId])
  @@index([pharmacyId])
}

// ============================================
// User Model
// ============================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  phone                 String?
  role                  Role      @default(PHARMACY_USER)
  orgId                 String?   // Users belong to an org (except ADMIN)
  isActive              Boolean   @default(true)
  mustChangePassword    Boolean   @default(false)
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org                 Org?              @relation(fields: [orgId], references: [id], onDelete: SetNull)
  pharmacyMemberships PharmacyMember[]
  managedPharmacies   ManagerPharmacy[]
  invoiceEvents       InvoiceEvent[]
  uploadedFiles       InvoiceFile[]
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]        @relation("auditLogs")
  supportTickets      SupportTicket[]   @relation("supportTicketsReported")

  @@index([orgId])
}

// ============================================
// Invoice Models
// ============================================

model InvoiceType {
  id          String   @id @default(uuid())
  orgId       String
  name        String   // e.g., "Rent", "Electricity", "Vendor Invoice"
  code        String   // Immutable code, e.g., "RENT", "ELECTRICITY"
  description String?
  isRequired  Boolean  @default(false) // Controls SLA expectations
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org                    Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices               Invoice[]
  requiredInvoiceTypes   RequiredInvoiceType[]
  invoiceRequirements    InvoiceRequirement[]

  @@unique([orgId, code])
  @@index([orgId])
}

model Vendor {
  id           String   @id @default(uuid())
  orgId        String
  pharmacyId   String?  // null = org-wide vendor
  name         String
  externalRef  String?  // External reference / account number
  phone        String?
  email        String?
  paymentTerms String?  // e.g., "Net 30"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  invoiceRequirements InvoiceRequirement[]

  @@index([orgId, pharmacyId, isActive])
  @@index([orgId])
}

model RequiredInvoiceType {
  id            String   @id @default(uuid())
  orgId         String
  pharmacyId    String?  // null = applies to all pharmacies
  invoiceTypeId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy?    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoiceType InvoiceType  @relation(fields: [invoiceTypeId], references: [id], onDelete: Cascade)

  @@unique([orgId, pharmacyId, invoiceTypeId])
  @@index([orgId])
  @@index([pharmacyId])
}

model Invoice {
  id            String        @id @default(uuid())
  pharmacyId    String
  vendorId      String?       // Nullable for extraction flow
  invoiceTypeId String?       // Nullable for extraction flow

  // Invoice details
  invoiceNumber String?       // Nullable for extraction flow
  accountNumber String?       // Alternative identifier (e.g., statement/account number)
  documentType  DocumentType  @default(INVOICE) // INVOICE, STATEMENT, CREDIT_MEMO, OTHER
  invoiceDate   DateTime?     // Nullable for extraction flow
  dueDate       DateTime?     // Nullable for extraction flow
  amount        Decimal?      @db.Decimal(12, 2) // Nullable for extraction flow
  currency      String        @default("USD")
  description   String?
  notes         String?       // Internal notes

  // Status tracking
  status        InvoiceStatus @default(DRAFT)
  entryMethod   EntryMethod   @default(MANUAL) // How the invoice was created
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedById  String?       // User who approved
  scheduledPaymentDate DateTime? // Date payment is scheduled for
  paidAt        DateTime?       // Actual payment date

  // Deadline tracking (5th/10th of month)
  deadlineDate  DateTime?     // Computed or set deadline

  // AI Extraction tracking
  needsReview        Boolean          @default(false)
  extractionStatus   ExtractionStatus @default(NONE)
  extractedAt        DateTime?
  lastExtractionId   String?          // FK to InvoiceExtraction

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pharmacy             Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  vendor               Vendor?               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  invoiceType          InvoiceType?          @relation(fields: [invoiceTypeId], references: [id], onDelete: Restrict)
  files                InvoiceFile[]
  events               InvoiceEvent[]
  slaEvents            SlaEvent[]
  extractions          InvoiceExtraction[]
  requirementInstances RequirementInstance[]

  @@index([pharmacyId])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([pharmacyId, status])
  @@index([pharmacyId, needsReview, status])
}

model InvoiceFile {
  id              String   @id @default(uuid())
  invoiceId       String
  originalName    String   // Original file name
  mimeType        String   // MIME type (e.g., application/pdf, image/png)
  sizeBytes       Int      // Size in bytes
  storagePath     String   // Path in storage provider
  uploadedByUserId String  // User who uploaded
  createdAt       DateTime @default(now())

  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy  User                @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  extractions InvoiceExtraction[]

  @@index([invoiceId])
}

// ============================================
// AI Extraction Models
// ============================================

model InvoiceExtraction {
  id             String           @id @default(uuid())
  invoiceId      String
  invoiceFileId  String
  provider       AIProvider
  model          String?          // e.g., "gemini-1.5-flash"

  // Extraction results
  extractedJson  Json             // Normalized extracted fields
  confidenceJson Json             // Per-field confidence scores (0-1)
  rawText        String?          @db.Text // Raw OCR/extracted text

  // Status tracking
  status         ExtractionStatus @default(PENDING)
  error          String?          @db.Text
  processingMs   Int?             // Processing time in milliseconds

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceFile InvoiceFile @relation(fields: [invoiceFileId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, createdAt])
  @@index([status])
}

model InvoiceEvent {
  id          String           @id @default(uuid())
  invoiceId   String
  eventType   InvoiceEventType
  userId      String           // User who triggered the event
  notes       String?          // Optional notes/comments
  metadata    Json?            // Additional event data
  createdAt   DateTime         @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([invoiceId, createdAt])
}

// ============================================
// SLA & Compliance Models
// ============================================

enum SlaEventType {
  SUBMISSION_MISSED        // Invoice not submitted by 5th
  PROCESSING_MISSED        // Invoice not processed by 10th
  SUBMISSION_REMINDER_SENT // Reminder sent before submission deadline
  PROCESSING_REMINDER_SENT // Reminder sent before processing deadline
}

// Frequency for recurring invoice requirements (legacy enum, kept for migration)
enum RequirementFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME
}

// Admin-configurable frequency reference data
model Frequency {
  id          String   @id @default(uuid())
  orgId       String
  name        String   // e.g., "Monthly", "Bi-Weekly"
  code        String   // e.g., "MONTHLY", "BI_WEEKLY"
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId])
}

// Admin-configurable invoice category (e.g., "Invoice", "Statement", "Credit Memo")
model InvoiceCategory {
  id          String   @id @default(uuid())
  orgId       String
  name        String   // e.g., "Invoice", "Statement"
  code        String   // e.g., "INVOICE", "STATEMENT"
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId])
}

// Status of a requirement instance
enum RequirementInstanceStatus {
  PENDING     // Not yet due, waiting for submission
  SUBMITTED   // Invoice submitted, pending processing
  PROCESSED   // Invoice processed (approved/paid)
  OVERDUE     // Past deadline, not yet submitted/processed
  MISSED      // Deadline passed, SLA violated
}

// Defines what invoices a pharmacy needs to submit
model InvoiceRequirement {
  id               String               @id @default(uuid())
  pharmacyId       String
  vendorId         String?              // Which vendor (null = any vendor)
  invoiceTypeId    String?              // Which invoice type (null = any type)

  // Requirement details
  name             String               // e.g., "Monthly ConEd Electricity Bill"
  description      String?
  frequency        RequirementFrequency @default(MONTHLY)

  // Deadline configuration (day of period) — required per requirement
  submissionDueDay Int                  @default(5)
  processingDueDay Int                  @default(10)

  // For quarterly/annual, which months apply (1-12, comma-separated for quarterly)
  // e.g., "3,6,9,12" for quarterly, "12" for annual December
  applicableMonths String?

  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  pharmacy    Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  vendor      Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoiceType InvoiceType?           @relation(fields: [invoiceTypeId], references: [id], onDelete: SetNull)
  instances   RequirementInstance[]

  @@index([pharmacyId])
  @@index([pharmacyId, isActive])
  @@index([vendorId])
}

// Tracks each occurrence of a requirement (e.g., Jan 2025, Feb 2025, etc.)
model RequirementInstance {
  id                  String                    @id @default(uuid())
  requirementId       String
  invoiceId           String?                   // Linked when invoice is submitted

  // Period this instance covers
  periodStart         DateTime                  // Start of the period (e.g., 2025-01-01)
  periodEnd           DateTime                  // End of the period (e.g., 2025-01-31)
  periodLabel         String                    // Human-readable: "January 2025", "Q1 2025", "2025"

  // Calculated deadlines for this specific instance
  submissionDeadline  DateTime                  // e.g., 2025-01-05
  processingDeadline  DateTime                  // e.g., 2025-01-10

  // Tracking
  status              RequirementInstanceStatus @default(PENDING)
  submittedAt         DateTime?
  processedAt         DateTime?
  submissionMet       Boolean?                  // null = not yet evaluated
  processingMet       Boolean?                  // null = not yet evaluated

  // Evaluation tracking
  lastEvaluatedAt     DateTime?
  notes               String?

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  requirement InvoiceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([requirementId, periodStart])
  @@index([requirementId])
  @@index([requirementId, status])
  @@index([submissionDeadline])
  @@index([status, submissionDeadline])
}

// Monthly invoice submission requirements per pharmacy
model MonthlyInvoiceRequirement {
  id            String   @id @default(uuid())
  pharmacyId    String
  yearMonth     String   // Format: "YYYY-MM"
  expectedCount Int      @default(1)  // How many invoices expected
  submittedCount Int     @default(0)  // How many submitted
  processedCount Int     @default(0)  // How many processed (approved/paid)
  isMet         Boolean  @default(false) // Overall SLA met
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, yearMonth])
  @@index([pharmacyId])
  @@index([yearMonth])
}

// SLA events log (violations, reminders)
model SlaEvent {
  id            String       @id @default(uuid())
  pharmacyId    String
  yearMonth     String       // Format: "YYYY-MM"
  eventType     SlaEventType
  invoiceId     String?      // Optional reference to specific invoice
  notes         String?
  metadata      Json?        // Additional data (counts, details)
  createdAt     DateTime     @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([pharmacyId, yearMonth])
  @@index([yearMonth, eventType])
}

// Notification log for tracking sent reminders/alerts
model NotificationLog {
  id            String   @id @default(uuid())
  pharmacyId    String?
  userId        String?
  type          String   // "sla_reminder", "sla_violation", etc.
  channel       String   // "email", "webhook", "in_app"
  subject       String?
  body          String?
  metadata      Json?    // Additional context
  sentAt        DateTime @default(now())
  deliveredAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([userId])
  @@index([type, sentAt])
}

// ============================================
// Notification Preferences
// ============================================

enum NotificationType {
  SLA_SUBMISSION_REMINDER
  SLA_PROCESSING_REMINDER
  SLA_SUBMISSION_VIOLATION
  SLA_PROCESSING_VIOLATION
  INVOICE_SUBMITTED
  INVOICE_APPROVED
  INVOICE_REJECTED
  INVOICE_OVERDUE
  AI_EXTRACTION_FAILED
  USER_REGISTERED
  PHARMACY_DEACTIVATED
}

model NotificationPreference {
  id               String           @id @default(uuid())
  orgId            String
  notificationType NotificationType
  enabled          Boolean          @default(true)
  channels         Json             @default("[\"in_app\"]")
  config           Json?
  recipientRoles   Json             @default("[\"ADMIN\"]")
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, notificationType])
  @@index([orgId])
}

// ============================================
// Audit Log Model
// ============================================

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String   // e.g., "org.updated", "pharmacy.created", "user.disabled"
  entityType   String   // e.g., "Org", "Pharmacy", "User", "PharmacyMember"
  entityId     String
  before       Json?    // Previous state snapshot
  after        Json?    // New state snapshot
  createdAt    DateTime @default(now())

  actor User @relation("auditLogs", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// Support Ticket System
// ============================================

enum SupportTicketStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  NEED_MORE_INFO
  FIXED
  RELEASED
  CLOSED
}

enum SupportIssueType {
  BUG
  FUNCTIONAL_ISSUE
  PERFORMANCE_ISSUE
  UI_UX_ISSUE
  DATA_ISSUE
  QUESTION
  FEATURE_REQUEST
}

enum SupportBusinessImpact {
  BLOCKING
  MAJOR
  MINOR
  COSMETIC
  SUGGESTION
}

enum SupportSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum SupportAttachmentType {
  SCREENSHOT
  ANNOTATED_SCREENSHOT
  AUDIO
  DOCUMENT
  OTHER
}

model SupportTicket {
  id                  String                @id @default(uuid())
  ticketNumber        String                @unique // e.g., "SUP-00001"
  portalKey           String                @default("pharmaopsflow")
  tenantId            String?               // orgId for multi-tenant scoping

  // Reporter info (denormalized for portability)
  reportedByUserId    String
  reportedByName      String
  reportedByEmail     String

  // User-provided fields
  issueType           SupportIssueType
  userTitle           String?               // Optional user-entered title
  userDescription     String                @db.Text
  voiceTranscript     String?               @db.Text

  // AI/structured fields
  structuredTitle     String?
  structuredSummary   String?               @db.Text
  stepsToReproduce    Json?                 // string[]
  expectedResult      String?               @db.Text
  actualResult        String?               @db.Text

  // Classification
  businessImpact      SupportBusinessImpact
  severity            SupportSeverity       @default(MEDIUM)
  category            String?               // Module/area of the portal

  // Status
  currentStatus       SupportTicketStatus   @default(SUBMITTED)

  // Context capture
  environment         String?               // e.g., "production", "staging"
  pageUrl             String?
  pageRoute           String?
  pageTitle           String?
  browserInfo         Json?                 // { browser, version, os, etc. }
  viewportInfo        Json?                 // { width, height }
  consoleErrors       Json?                 // Recent console errors
  failedApiRequests   Json?                 // Recent failed API calls
  metadata            Json?                 // Any additional context

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  reporter            User                  @relation("supportTicketsReported", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  attachments         SupportTicketAttachment[]
  comments            SupportTicketComment[]
  statusHistory       SupportTicketStatusHistory[]
  assignments         SupportTicketAssignment[]

  @@index([reportedByUserId])
  @@index([currentStatus])
  @@index([tenantId])
  @@index([issueType])
  @@index([severity])
  @@index([createdAt])
  @@index([ticketNumber])
}

model SupportTicketAttachment {
  id              String                @id @default(uuid())
  ticketId        String
  fileName        String
  fileType        String                // MIME type
  fileSize        Int                   // bytes
  storagePath     String
  attachmentType  SupportAttachmentType @default(OTHER)
  createdAt       DateTime              @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketComment {
  id              String   @id @default(uuid())
  ticketId        String
  authorUserId    String
  authorName      String
  authorRole      String   // Role at time of comment
  isInternal      Boolean  @default(false) // Internal dev notes vs user-visible
  commentText     String   @db.Text
  createdAt       DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

model SupportTicketStatusHistory {
  id              String              @id @default(uuid())
  ticketId        String
  oldStatus       SupportTicketStatus
  newStatus       SupportTicketStatus
  changedByUserId String
  changedByName   String
  note            String?             @db.Text
  createdAt       DateTime            @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

model SupportTicketAssignment {
  id               String   @id @default(uuid())
  ticketId         String
  assignedToUserId String
  assignedToName   String
  assignedByUserId String
  assignedAt       DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([assignedToUserId])
}
