# ===========================================
# PharmaOpsFlow Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -----------------------------
# Database (Required)
# -----------------------------
# For Supabase: Use the connection string from Project Settings > Database
# For other providers: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmaopsflow?schema=public

# Supabase (if using Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------
# Authentication (Required)
# -----------------------------
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# -----------------------------
# API Server
# -----------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# -----------------------------
# Web Frontend
# -----------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------
# Redis (if using background jobs/caching)
# -----------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------
# File Storage
# -----------------------------
# Storage provider: "supabase", "local", or "auto" (default)
# "auto" uses Supabase if credentials are provided, otherwise local
# STORAGE_PROVIDER=auto

# Supabase Storage (recommended for production)
# Uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from above
# SUPABASE_STORAGE_BUCKET=invoices

# Local Storage (for development without Supabase)
# Files stored in ./uploads directory
# LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (future)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Azure Blob Storage (future)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# -----------------------------
# SLA Configuration
# -----------------------------
# Day of month for invoice submission deadline (default: 5)
SUBMISSION_DUE_DAY=5

# Day of month for invoice processing deadline (default: 10)
PROCESSING_DUE_DAY=10

# Timezone for SLA calculations (default: America/New_York)
ORG_TIMEZONE=America/New_York

# -----------------------------
# Email / SMTP (if email features enabled)
# -----------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourapp.com

# -----------------------------
# AI Invoice Extraction
# -----------------------------
# Provider selection: "openai" (default), "gemini", "anthropic"
AI_PROVIDER=openai

# OpenAI API (default for invoice extraction)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Google Gemini API (alternative)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic API (future support)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Extraction webhook secret (for n8n integration)
# EXTRACTION_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------
# AI Chat (Manager Insights)
# -----------------------------
# Enable AI chat functionality for query planning
AI_ENABLED=true

# Chat-specific models (separate from extraction)
# OpenAI model for chat (defaults to gpt-4o-mini for cost efficiency)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini model for chat (if using Gemini)
# GEMINI_CHAT_MODEL=gemini-1.5-flash

# Rate limiting for chat endpoints (requests per minute per user)
CHAT_RATE_LIMIT_PER_MIN=20

# -----------------------------
# GitHub Integration (if enabled)
# -----------------------------
# GITHUB_PAT=your-personal-access-token
