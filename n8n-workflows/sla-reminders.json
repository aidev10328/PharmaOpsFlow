{
  "name": "PharmaOpsFlow - SLA Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 3,4 * *"
            }
          ]
        }
      },
      "id": "submission-reminder-trigger",
      "name": "Submission Reminder (3rd/4th)",
