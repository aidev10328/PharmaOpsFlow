      "typeVersion": 4.1,
      "position": [480, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pharmaopsflow-api-key",
          "name": "PharmaOpsFlow API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-reminders-sent",
              "leftValue": "={{ $json.remindersSent }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-submission-sent",
      "name": "Check Submission Reminders Sent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-reminders-sent-2",
              "leftValue": "={{ $json.remindersSent }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-processing-sent",
      "name": "Check Processing Reminders Sent",
